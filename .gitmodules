[submodule "panda"]
  path = panda
  url = https://github.com/trentaterrito/flashpilot-panda.git
[submodule "opendbc"]
  path = opendbc_repo
  url = https://github.com/trentaterrito/flashpilot-opendbc.git
  # FlashPilot: repointed from ../../commaai/opendbc.git to carry the
  # F-150 Lightning fingerprint patch (this session has no push access
  # to commaai/opendbc directly). Upstream is tracked as the "upstream"
  # remote inside opendbc_repo for future syncing.
[submodule "msgq"]
  path = msgq_repo
  url = ../../commaai/msgq.git
[submodule "rednose_repo"]
  path = rednose_repo
  url = ../../commaai/rednose.git
[submodule "teleoprtc_repo"]
  path = teleoprtc_repo
  url = ../../commaai/teleoprtc
[submodule "tinygrad"]
  path = tinygrad_repo
  url = https://github.com/tinygrad/tinygrad.git
